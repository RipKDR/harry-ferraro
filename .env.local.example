# Copy this to .env.local and fill in your values.

# Site URL (for canonical, sitemap, robots, OG tags).
# Falls back to the live Vercel URL if unset.
NEXT_PUBLIC_SITE_URL=https://harry-ferraro.vercel.app

# Email (Resend — https://resend.com, generous free tier).
RESEND_API_KEY=re_your_api_key_here

# "From" address for outgoing form emails.
# Default "onboarding@resend.dev" works for testing on any Resend account.
CONTACT_FROM="Harrison Ferraro <onboarding@resend.dev>"
