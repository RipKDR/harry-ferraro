# Resend email API key — get at resend.com
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Your domain (used for canonical URLs and OG images)
NEXT_PUBLIC_SITE_URL=https://harryferraro.com.au

# Stripe — get at dashboard.stripe.com
STRIPE_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
