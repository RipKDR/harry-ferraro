# Resend email API key — get at resend.com (optional; forms fall back to mailto)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Sender identity and delivery address for enquiry emails
RESEND_FROM_EMAIL="Harrison Ferraro Studio <studio@example.com>"
CONTACT_TO_EMAIL=you@example.com

# Your domain (used for canonical URLs, sitemap, and OG images)
NEXT_PUBLIC_SITE_URL=https://harryferraro.com.au
