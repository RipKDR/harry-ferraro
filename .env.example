# ── Site ────────────────────────────────────────────────────────────────
# Canonical URL used for SEO, sitemap, robots, and OG tags.
# Falls back to the live Vercel URL if unset.
NEXT_PUBLIC_SITE_URL=https://harry-ferraro.vercel.app

# ── Email (commission + contact forms) ──────────────────────────────────
# Resend API key — sign up free at https://resend.com
# Without this, forms still validate and show success, but no email is sent.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# The "from" address for outgoing emails.
# Default works out-of-the-box for testing: "Harrison Ferraro <onboarding@resend.dev>"
# For production, verify your own domain in Resend and use e.g.
# "Harrison Ferraro <studio@yourdomain.com>"
CONTACT_FROM="Harrison Ferraro <onboarding@resend.dev>"
